# ---------------------------------------------------------------------------
# ROMs del juego original -- NO distribuir.
#
# Yu Yu Hakusho: Makyou Toitsusen (1994) es de Treasure, con licencia de
# Toei Animation y Shueisha. Los dumps completos son la obra completa con
# derechos de autor: subirlos expone la cuenta a un takedown por DMCA.
#
# La carpeta rom/ entera queda fuera: base/, modificadas/ y fuentes/.
#
# Y NO hay que ignorar *.bin a lo bruto: los assets/imagenes/*.bin SI son
# binarios legitimos del proyecto (volcados de VRAM de 64 KB y CRAM de 128 B)
# y estan versionados a proposito. Lo que protege este fichero es la RUTA.
# ---------------------------------------------------------------------------
/rom/

# ---------------------------------------------------------------------------
# El repo de notas es un repo git PROPIO (github.com/Akara1996/yuyu-rom-notas)
# con su historial de 126 commits. No se mete en este repo: se usa como
# sub-repo dentro de notas/.
# ---------------------------------------------------------------------------
/notas/

# ---------------------------------------------------------------------------
# Ruta local a la ROM. Cada maquina tiene la suya; no se comparte.
# Se escribe una sola linea con la ruta. Ver herramientas/desensamblado/ruta_rom.py
# ---------------------------------------------------------------------------
/.rom_path

# ---------------------------------------------------------------------------
# ROMs externas de referencia (betas, protos, otras regiones): misma politica
# de copyright que rom/: NO distribuir.
# ---------------------------------------------------------------------------
/netwave/

# Cach autogenerada por Godot (se regenera al abrir el proyecto)
.godot/
*.import

# Logs de captura y salida de herramientas: ruido de debug
*.err
*.out

# Python
__pycache__/
*.py[cod]

# Sistema operativo / editores
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/
